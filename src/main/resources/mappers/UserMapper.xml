<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.user.mapper.UserMapper">

    <resultMap id="userResultMap" type="org.example.user.entity.User">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="name" column="name"/>
        <result property="password" column="password"/>
        <result property="createAt" column="created_at"/>
    </resultMap>

    <!-- 전체 조회 -->
    <select id="findAll" resultMap="userResultMap">
        SELECT * FROM `user`
    </select>

    <!-- id(PK)로 단건 조회 -->
    <select id="findById" parameterType="int" resultMap="userResultMap">
        SELECT * FROM `user` WHERE id = #{id}
    </select>

    <!-- user_id(로그인 ID)로 단건 조회 -->
    <select id="findByUserId" parameterType="String" resultMap="userResultMap">
        SELECT * FROM `user` WHERE user_id = #{userId}
    </select>

    <!-- 이름 LIKE 검색 -->
    <select id="findByNameLike" parameterType="String" resultMap="userResultMap">
        SELECT * FROM `user` WHERE name LIKE #{name}
    </select>

    <!-- 등록 -->
    <insert id="save" parameterType="org.example.user.entity.User" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `user` (user_id, name, password) VALUES (#{userId}, #{name}, #{password})
    </insert>

    <!-- 수정 -->
    <update id="update" parameterType="org.example.user.entity.User">
        UPDATE `user` SET user_id = #{userId}, name = #{name}, password = #{password} WHERE id = #{id}
    </update>

    <!-- 삭제 -->
    <delete id="deleteById" parameterType="int">
        DELETE FROM `user` WHERE id = #{id}
    </delete>

</mapper>
